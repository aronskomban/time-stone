# PostgreSQL connection used only on the server
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public origin of this deployment. Use a full URL including the scheme:
#   APP_ORIGIN=https://app.example.com
# A bare host is also accepted and treated as https:
#   APP_ORIGIN=app.example.com
# This value is used for verification/invitation links AND as an allowed
# host for the same-origin (CSRF) check, together with the request Host.
# It must be the host users type in the browser, not 0.0.0.0 or localhost
# unless you are only developing locally.
APP_ORIGIN=https://app.example.com

# SMTP for verification and invitation email. Required in production.
# Example: smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="Time Stone <no-reply@app.example.com>"

# Development only. When SMTP is unset, set this to true to return one-time
# verification/invitation links in API responses (shown in the UI).
# Never enable this on a public production deployment.
AUTH_DEV_LINKS=false
